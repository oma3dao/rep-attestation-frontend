# OMATrust Reputation Frontend — Environment Variables
#
# The active chain determines the environment prefix for all service URLs
# (via CHAIN_PREFIX_MAP in src/lib/service-urls.ts):
#   omachain-mainnet  → no prefix  (e.g., backend.omatrust.org)
#   omachain-testnet  → test.      (e.g., test.backend.omatrust.org)
#   omachain-devnet   → dev.       (e.g., dev.backend.omatrust.org)

# Thirdweb Client ID
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_client_id_here

# Active Chain — determines chain config, contract addresses, and environment prefix
NEXT_PUBLIC_ACTIVE_CHAIN=omachain-testnet

# Optional: Enable debug logging
NEXT_PUBLIC_DEBUG_ADAPTER=true

# ============================================
# Service Domains
# ============================================
# Base domains for OMATrust services. The active chain determines the
# environment prefix (test., dev., or none for production).
# Override with localhost:PORT for local development.
#
# The code uses NEXT_PUBLIC_OMATRUST_BACKEND_DOMAIN (not _URL).
# It's a bare domain — the prefix is derived from NEXT_PUBLIC_ACTIVE_CHAIN.
# Only override for local dev; deployed environments use the default.
# NEXT_PUBLIC_OMATRUST_BACKEND_DOMAIN=localhost:3001

# ============================================
# Maintenance Mode
# ============================================

# Set to "true" during planned dependency maintenance (e.g., Thirdweb secret key rotation).
# When true, delegated attestation auth failures return a friendly scheduled-maintenance 503
# instead of logging a critical alert. Requires redeployment to take effect.
MAINTENANCE_IN_PROGRESS=false

# ============================================
# Delegated Attestation (Server-side)
# ============================================
#
# The code checks THIRDWEB_SECRET_KEY + THIRDWEB_SERVER_WALLET_ADDRESS first.
# If both are set (non-empty), it uses the Thirdweb Server Wallet (no raw key needed).
# If either is empty, it falls back to EAS_DELEGATE_PRIVATE_KEY.
#
# Testnet/Mainnet: use Thirdweb Server Wallet (set both values below).
# Local dev/Preview: use EAS_DELEGATE_PRIVATE_KEY or ~/.ssh/local-attestation-key file.
THIRDWEB_SECRET_KEY=replace-with-thirdweb-secret
THIRDWEB_SERVER_WALLET_ADDRESS=0xYourServerWalletAddress

# EAS Delegate private key — fallback when server wallet is not configured.
# For local dev, you can also use ~/.ssh/local-attestation-key file (shared with app-registry-frontend)
# Generate: node -e "console.log('0x' + require('crypto').randomBytes(32).toString('hex'))" > ~/.ssh/local-attestation-key && chmod 600 ~/.ssh/local-attestation-key
# EAS_DELEGATE_PRIVATE_KEY=0x...

# Maximum gas per delegated attestation transaction (default: 800000)
# MAX_GAS_PER_TX=800000

# ============================================
# Review Widget
# ============================================

# Widget base URL — determines where the review widget iframe loads from.
# Must match the environment:
#   Local dev:  http://localhost:3000
#   Testnet:    https://test.widgets.omatrust.org
#   Production: https://widgets.omatrust.org (or omit to use default)
# Also used as the devOriginOverride for the SDK signing bridge.
# NEXT_PUBLIC_WIDGET_BASE_URL=http://localhost:3000
